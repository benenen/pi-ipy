{
  "name": "pi-ipy",
  "version": "0.1.0",
  "description": "Run Python scripts from a temp file you can re-run and edit — gives pi a home for \"write a program\" instead of a bash heredoc",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "main": "index.ts",
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^24.19.1",
    "typebox": "^1.3.34",
    "typescript": "^5.9.3"
  }
}
